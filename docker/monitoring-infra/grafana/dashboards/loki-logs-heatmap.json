{
  "id": null,
  "uid": "loki-logs-heatmap",
  "title": "Loki - Logs Overview",
  "tags": [
    "observability",
    "loki",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d",
      "30d"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "type": "dashboard",
        "name": "Annotations & Alerts",
        "enable": true,
        "hide": false,
        "builtIn": 1,
        "iconColor": "rgba(0, 211, 255, 1)",
        "typeData": {}
      }
    ]
  },
  "panels": [
    {
      "type": "logs",
      "title": "Application logs (Loki)",
      "id": 1,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true
      },
      "targets": [
        {
          "expr": "{app=\"ecommerce\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Log volume over time",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate({app=\"ecommerce\"}[5m]))",
          "refId": "A",
          "legendFormat": "logs/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "logs/s"
        },
        "overrides": []
      }
    }
  ]
}