{
  "title": "Node Exporter - Host",
  "uid": "node-exp",
  "schemaVersion": 38,
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["host", "metrics"],
  "panels": [
    {
      "type": "gauge",
      "title": "CPU %",
      "targets": [
        { "datasource": "Prometheus", "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)" }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 }
    },
    {
      "type": "gauge",
      "title": "Memory %",
      "targets": [
        { "datasource": "Prometheus", "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)" }
      ],
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 }
    },
    {
      "type": "graph",
      "title": "Load Average",
      "targets": [
        { "datasource": "Prometheus", "expr": "node_load1" }
      ],
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 6 }
    }
  ]
}
